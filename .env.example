# Real app PUBLIC configuration. These values are readable by every browser user.
# Never put a Supabase secret/service-role key or provider secret here.
MIZNORA_SUPABASE_URL=
MIZNORA_SUPABASE_PUBLISHABLE_KEY=
MIZNORA_ALLOW_SIGNUP=false
# Demo build path only; defaults to / for local preview.
DEMO_BASE_PATH=/
APP_BASE_PATH=/

# Optional REAL LOCAL STACK tests only (loopback origin, never a hosted project).
# MIZNORA_TEST_SUPABASE_URL=
# MIZNORA_TEST_SUPABASE_PUBLISHABLE_KEY=

# Backend/CI ONLY: configure in a protected secret store, not Angular.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
# Use distinct protected staging/production environments with this same variable name.
